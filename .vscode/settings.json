{
    "workbench.colorTheme": "Quiet Light",
    "workbench.iconTheme": "vs-seti",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 3,
    "editor.smoothScrolling": true,
    "editor.renderLineHighlight": "line",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.autoClosingDelete": "always",
    "editor.autoClosingOvertype": "auto",
    "editor.autoSurround": "never",
    "editor.fontLigatures": true,
    "editor.formatOnSave": true,
    "[terraform]": {
        "editor.autoClosingBrackets": "always",
        "editor.autoClosingQuotes": "always",
        "editor.autoClosingDelete": "always",
        "editor.autoClosingOvertype": "always",
        "editor.autoSurround": "languageDefined"
    },
    "[hcl]": {
        "editor.autoClosingBrackets": "always",
        "editor.autoClosingQuotes": "always",
        "editor.autoClosingDelete": "always",
        "editor.autoClosingOvertype": "always",
        "editor.autoSurround": "languageDefined"
    },
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "window.autoDetectColorScheme": false,
    "editor.fontSize": 16,
    "editor.lineHeight": 24,
    "editor.hover.enabled": "off",
    "editor.parameterHints.enabled": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.colorDecorators": true,
    "editor.tokenColorCustomizations": {
        "textMateScopeName.variable": "#00FF00",
        "variable": "#00FF00",
        "string": "#FF6B6B",
        "keyword": "#4ECDC4",
        "comment": "#95E1D3",
        "number": "#FFD93D",
        "function": "#00FFFF"
    },
    "workbench.colorCustomizations": {
        "editor.background": "#ffffff",
        "editor.foreground": "#000000",
        "editor.lineHighlightBackground": "#f0f0f0",
        "editorCursor.foreground": "#000000",
        "editorCursor.background": "#ffffff",
        "editorLineNumber.foreground": "#666666",
        "editor.selectionBackground": "#d7d7d7",
        "editor.selectionHighlightBackground": "#ebebeb",
        "sideBar.background": "#f3f3f3",
        "sideBar.foreground": "#000000",
        "activityBar.background": "#f3f3f3",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#666666",
        "statusBar.background": "#e7e7e7",
        "statusBar.foreground": "#000000",
        "titleBar.activeBackground": "#f3f3f3",
        "titleBar.activeForeground": "#000000",
        "titleBar.inactiveBackground": "#e7e7e7",
        "panel.background": "#f7f7f7",
        "panel.border": "#cccccc",
        "breadcrumb.background": "#f7f7f7",
        "breadcrumb.foreground": "#000000",
        "tab.activeBackground": "#ffffff",
        "tab.inactiveBackground": "#f3f3f3",
        "tab.activeForeground": "#000000",
        "tab.inactiveForeground": "#666666",
        "editorGroupHeader.tabsBackground": "#f3f3f3"
    },
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.inlineSuggest.enabled": false,
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.suggest.showIcons": true,
    "editor.suggest.localityBonus": true
}